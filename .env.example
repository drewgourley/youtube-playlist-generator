# Server-side configuration. Copy this file to `.env` on the server and fill in
# the values. These secrets are NEVER sent to the browser.

# Port the backend listens on.
PORT=3173

# App environment: "development" or "production". Named APP_ENV (not NODE_ENV) so
# it can live here without forcing the Vite client build into development mode.
# In production this enables secure cookies and static SPA hosting.
APP_ENV=development

# Public origin(s) of the app, comma-separated. Used for CORS origin checks and
# as the post-login redirect target. In production set this to your real URL,
# e.g. https://playlists.example.com
APP_ORIGIN=http://localhost:5173

# Set to any value if the app runs behind a reverse proxy that terminates TLS
# (needed so secure cookies work). Leave blank otherwise.
TRUST_PROXY=

# YouTube Data API v3 key (server-side only).
YT_API_KEY=

# Google OAuth 2.0 Web client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Dev:  http://localhost:3173/api/auth/callback
# Prod: https://your-domain/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:3173/api/auth/callback

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
